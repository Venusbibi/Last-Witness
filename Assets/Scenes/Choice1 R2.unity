  m_Script: {fileID: 11500000, guid: a3b1a9ba5304342468c9f1c0dd362084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  nameTextComponent: {fileID: 1258240707}
  textComponent: {fileID: 1904657092}
  buttonToShowAfterDialogue: {fileID: 261331403}
  lines:
  - characterName: 'Enemy:'
    sentence: "\u201CHahaha\u2026 I know who you\u2019re lookin\u2019 for.\u201D"
  - characterName: 'Player:'
    sentence: "\u201C\u2026\u201D"
  - characterName: 'Enemy:'
    sentence: "\u201CYou really thought your little mission was a secret?\u201D"
  - characterName: 'Enemy:'
    sentence: "\u201CThe one who sent you\u2026 they knew you\u2019d come here.\u201D"
  - characterName: 'Player:'
    sentence: "\u201CTell me who sent me.\u201D"
  - characterName: 'Enemy:'
    sentence: "\u201CDon\u2019t know the name.\u201D"
  - characterName: 'Player:'
    sentence: "\u201CThen tell me what you do know.\u201D"
  - characterName: 'Enemy:'
    sentence: "\u201CThe one who sent you here never wanted you to kill the owner.\u201D"
  - characterName: 'Enemy:'
    sentence: "\u201CThey wanted you to come here.\u201D"
  - characterName: 'Player:'
    sentence: "\u201CWhy?\u201D"
  - characterName: 'Enemy:'
    sentence: "\u201C\u2026\u201D"
  - characterName: Outcome
    sentence: "\u201CBecause the owner knows about you.\u201D"
  - characterName: Outcome
    sentence: ' The arena owner knows the truth about the protagonist.'
  textSpeed: 0.1
